<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Melotune" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Dark theme colors -->
        <item name="colorPrimary">@color/ocean_blue</item>
        <item name="colorPrimaryVariant">@color/cyan_accent</item>
        <item name="colorOnPrimary">@color/text_light</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/text_light</item>

        <item name="colorSurface">#1E293B</item>
        <item name="colorOnSurface">@color/text_light</item>

        <item name="colorAccent">@color/cyan_accent</item>

        <!-- Text colors -->
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>

        <!-- Divider -->
        <item name="android:divider">@color/divider_dark</item>

        <item name="android:icon">@mipmap/ic_launcher_night</item>
        <item name="android:roundIcon" tools:ignore="NewApi">@mipmap/ic_launcher_night_round</item>
    </style>

</resources>