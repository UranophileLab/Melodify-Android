<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating mini-player card layout
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/play_bar_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/play_bar_background"
    android:elevation="@dimen/_12sdp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Main content row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_6sdp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/_10sdp"
            app:strokeWidth="0.5dp"
            app:strokeColor="@color/textSec">

            <ImageView
                android:id="@+id/play_bar_cover_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/spotify_dark_green"
                android:contentDescription="Mini Player Cover Image" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/play_bar_music_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:text="@string/app_name"
                android:fontFamily="@font/avenir_next_bold"
                android:textColor="@color/textMain"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/play_bar_music_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:text="@string/app_name"
                android:fontFamily="@font/avenir_next_regular"
                android:textColor="@color/textSec"
                android:textSize="@dimen/_10ssp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/play_bar_prev_icon"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:focusable="true"
                android:src="@drawable/skip_previous_24px"
                android:clickable="true"
                android:padding="@dimen/_3sdp"
                app:tint="@color/textMain"
                android:contentDescription="Previous" />

            <ImageView
                android:id="@+id/play_bar_play_pause_icon"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:src="@drawable/play_arrow_24px"
                android:padding="@dimen/_2sdp"
                android:focusable="true"
                android:clickable="true"
                app:tint="@color/textMain"
                android:contentDescription="Play/Pause" />

            <ImageView
                android:id="@+id/play_bar_next_icon"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:focusable="true"
                android:src="@drawable/skip_next_24px"
                android:clickable="true"
                android:padding="@dimen/_3sdp"
                app:tint="@color/textMain"
                android:contentDescription="Next" />

            <ImageView
                android:id="@+id/play_bar_queue_icon"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:focusable="true"
                android:src="@drawable/ic_queue_music"
                android:clickable="true"
                android:padding="@dimen/_4sdp"
                app:tint="@color/textMain"
                android:contentDescription="Queue" />

        </LinearLayout>

    </LinearLayout>

    <!--
      Thin progress bar pinned to the bottom of the card.
    -->
    <ProgressBar
        android:id="@+id/play_bar_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="@android:color/transparent"
        android:progressTint="@color/textMain"
        android:indeterminate="false" />

</FrameLayout>
