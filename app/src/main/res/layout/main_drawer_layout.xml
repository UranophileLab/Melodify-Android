<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_gradient"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingVertical="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/_8sdp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/icon" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenir_next_bold"
                android:text="@string/app_name"
                android:textColor="@color/text_light"
                android:textSize="@dimen/_16ssp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.7dp"
        android:layout_marginVertical="@dimen/_12sdp"
        android:background="#33FFFFFF" />

    <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
        android:id="@+id/library"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_library_music_24"
        app:srcPadding="@dimen/_4sdp"
        app:title="Your Library" />

    <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
        android:id="@+id/favorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/favorite_24px"
        app:srcPadding="@dimen/_4sdp"
        app:title="Favorites" />

    <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
        android:id="@+id/history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/round_history_24"
        app:srcPadding="@dimen/_4sdp"
        app:title="History" />

    <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
        android:id="@+id/download_manager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_download_for_offline_24"
        app:srcPadding="@dimen/_4sdp"
        app:title="Downloads" />

    <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/settings_24px"
        app:srcPadding="@dimen/_4sdp"
        app:title="Settings and privacy" />

    <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
        android:id="@+id/updates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_update_24"
        app:srcPadding="@dimen/_4sdp"
        app:title="Check for Updates" />

    <dev.melodify.uranophilelab.utils.customview.BottomSheetItemView
        android:id="@+id/about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/round_info_outline_24"
        app:srcPadding="@dimen/_4sdp"
        app:title="About" />

    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/versionTxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/avenir_next_regular"
        android:gravity="center"
        android:paddingStart="@dimen/_12sdp"
        android:text="version 4.1.0"
        android:textColor="#B3B3B3"
        tools:ignore="RtlSymmetry" />

</LinearLayout>
